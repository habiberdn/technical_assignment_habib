# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Salin file ini menjadi '.env' di folder backend/ sebelum menjalankan aplikasi.
# ==============================================================================

# APP & SERVER CONFIGURATION
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE CONFIGURATION (PostgreSQL / Prisma Connection String)
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/database_name?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_clinic"

# JWT AUTHENTICATION CONFIGURATION
JWT_SECRET="super_secret_jwt_key_maganghub_2026_change_in_production"
JWT_EXPIRES_IN="1d"
